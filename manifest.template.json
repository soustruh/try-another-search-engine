{
    "manifest_version": 2,
    "name": "Try another search engine",
    "description": "Switch between Google, Seznam, DuckDuckGo, Ecosia, Bing and Brave search results",
    "icons": {
        "48": "icons/ses_48.png"
    },
    "background": {
        "scripts": [
            "src/common/restoreOptions.js",
            "src/background/background.js",
            "src/background/http.js"
        ]
    },
    "content_scripts": [
        {
            "matches": [
                "*://www.google.com/*",
                "*://www.google.cz/*",
                "*://search.seznam.cz/*",
                "*://duckduckgo.com/*",
                "*://www.ecosia.org/*",
                "*://www.bing.com/*",
                "*://search.brave.com/*"
            ],
            "css": ["src/content/content.css"],
            "js": [
                "src/common/restoreOptions.js",
                "src/common/searchEngines.js",
                "src/content/content.js"
            ]
        }
    ],
    "options_ui": {
        "page": "src/options/options.html"
    },
    "permissions": ["storage"],
    "web_accessible_resources": ["icons/*"],
    "browser_specific_settings": {
        "gecko": {
            "id": "{14c48e36-100d-4d9b-a11a-890112654de9}"
        }
    }
}
